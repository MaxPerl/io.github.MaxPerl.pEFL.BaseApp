[
   {
      "dest": "perl-libs/ExtUtils-PkgConfig",
      "sha256": "bbeaced995d7d8d10cfc51a3a5a66da41ceb2bc04fedcab50e10e6300e801c6e",
      "type": "archive",
      "url": "https://cpan.metacpan.org/authors/id/X/XA/XAOC/ExtUtils-PkgConfig-1.16.tar.gz"
   },
   {
      "dest": "perl-libs/pEFL",
      "sha256": "7ae30441b72710810363bc75a2205715843a73e8099c1062da57cbbd122bb23e",
      "type": "archive",
      "url": "https://cpan.metacpan.org/authors/id/P/PE/PERLMAX/pEFL-0.7701.tar.gz"
   },
   {
      "dest": "perl-libs/pEFL",
      "type": "patch",
      "path": "p2.patch"
   },
   {
      "commands": [
         "set -e",
         "export PERL_MM_OPT='NO_PACKLIST=1 NO_PERLLOCAL=1 INSTALLMAN1DIR=none INSTALLMAN3DIR=none'",
         "export PERL_MB_OPT='--create_packlist 0 --install_path libdoc= --install_path bindoc='",
         "function make_install {",
         "    mod_dir=$1",
         "    cd $mod_dir",
         "    if [ -f 'Makefile.PL' ]; then",
         "        perl Makefile.PL PREFIX=${FLATPAK_DEST} && make install PREFIX=${FLATPAK_DEST}",
         "    elif [ -f 'Build.PL' ]; then",
         "        perl Build.PL && ./Build && ./Build install",
         "    else",
         "        echo 'No Makefile.PL or Build.PL found. Do not know how to install this module'",
         "        exit 1",
         "    fi",
         "}",
         "(make_install perl-libs/ExtUtils-PkgConfig)",
         "(make_install perl-libs/pEFL)"
      ],
      "dest": "perl-libs",
      "dest-filename": "install.sh",
      "type": "script"
   }
]
